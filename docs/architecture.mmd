flowchart LR
  %% =====================
  %% Runtime / Deployment
  %% =====================
  subgraph Runtime["Runtime / Deployment"]
    Browser["User Browser"]
    Nginx["Nginx (optional VM reverse proxy)<br>deploy/nginx/decidio.conf"]
    LocalFE["Frontend container (optional)<br>React + Vite dev server :5173"]
    BackendSvc["Backend container<br>FastAPI + Uvicorn :8015"]
    PostgresSvc["Postgres container<br>postgres:16"]
  end

  Browser -->|HTTPS| Nginx
  Nginx -->|/api + static| BackendSvc
  Browser -->|http://localhost:5173| LocalFE
  LocalFE -->|VITE_API_BASE_URL -> /api| BackendSvc
  BackendSvc -->|asyncpg| PostgresSvc

  %% =====================
  %% Frontend
  %% =====================
  subgraph Frontend["Frontend (frontend/src)"]
    AppUI["UI Components<br>AuthScreen, WelcomeScreen, RoundArena, Summary"]
    ApiClient["lib/api.js<br>fetch wrapper + auth token localStorage"]
    AppUI --> ApiClient
  end

  Browser --> AppUI

  %% =====================
  %% FastAPI App
  %% =====================
  subgraph FastAPI["FastAPI App (backend/app/main.py)"]
    Startup["startup event<br>init_db -> verify_connection<br>ensure_multicategory_compatibility<br>recommender.refresh"]
    ProductEndpoints["/api/products<br>/api/products/{id}"]
    GameRoutes["routes/game.py<br>/api/game/*"]
    AuthRoutes["routes/auth.py<br>/api/auth/*"]
    StaticMount["Static mount<br>serve frontend/dist when available"]
  end

  ApiClient -->|HTTP JSON| ProductEndpoints
  ApiClient -->|HTTP JSON| GameRoutes
  ApiClient -->|HTTP JSON| AuthRoutes
  Startup --> ProductEndpoints
  Startup --> GameRoutes
  Startup --> AuthRoutes
  Startup --> StaticMount

  %% =====================
  %% Services / ML
  %% =====================
  subgraph Services["Backend Services"]
    GameService["services/game_service.py<br>composition root"]
    GamePlay["services/game_play.py<br>onboarding, round start, pick scoring"]
    GameInsights["services/game_insights.py<br>summary, status, leaderboard, history"]
    AuthService["services/auth.py<br>PBKDF2 password hash + session tokens"]
    SchemaService["services/schema_service.py<br>category/schema compatibility"]
    CategoryProfiles["category_profiles.py<br>category config + feature labels"]
  end

  GameRoutes --> GameService
  GameService --> GamePlay
  GameService --> GameInsights
  GamePlay --> CategoryProfiles
  GameInsights --> CategoryProfiles
  AuthRoutes --> AuthService
  Startup --> SchemaService

  subgraph ML["ML / Recommendation"]
    Recommender["services/recommender.py<br>cache item vectors + refresh"]
    PrefixCF["ml/prefix_cf.py<br>FeatureSpace + PrefixCFModel"]
    PBCF["ml/pbcf_nmf.py<br>PBCFEngine (NMF-based)"]
  end

  Startup --> Recommender
  GameService --> Recommender
  GamePlay --> PrefixCF
  GameInsights --> PrefixCF
  Recommender --> PrefixCF
  Recommender --> PBCF

  %% =====================
  %% Database schema
  %% =====================
  subgraph DB["Postgres Tables (backend/app/db.py)"]
    Products[("products")]
    Users[("users<br>password_hash + session_tokens[]")]
    Games[("games<br>model_state + onboarding state")]
    Rounds[("game_rounds<br>round outcomes + ai_top_k")]
    PrefixRatings[("prefix_ratings<br>onboarding ratings")]
  end

  ProductEndpoints --> Products
  AuthService --> Users
  GameService --> Games
  GameService --> Rounds
  GameService --> PrefixRatings
  GameService --> Products
  GameService --> Users
  Recommender --> Products
  Recommender --> PrefixRatings
  Recommender --> Games
  Recommender --> Rounds

  %% =====================
  %% Data pipelines
  %% =====================
  subgraph Pipelines["Data / Evaluation Scripts (backend/scripts)"]
    LoadDB["load_db.py<br>seed products.json (fountain_pens)"]
    ScrapePens["scrape_gouletpens.py<br>build pen dataset"]
    IngestTMDB["ingest_movies_tmdb.py<br>TMDB -> products(category=movies)"]
    Migrate["migrate_multicategory_schema.py<br>category migration helper"]
    Evaluate["evaluate_pbcf.py<br>offline model metrics"]
    Checkpoint["backend/data/tmdb_ingest_checkpoint.json"]
    LocalData["backend/data/products.json"]
  end

  LocalData --> LoadDB
  ScrapePens --> LocalData
  LoadDB --> Products
  IngestTMDB --> Products
  IngestTMDB --> Checkpoint
  Migrate --> Products
  Migrate --> Games
  Migrate --> Rounds
  Evaluate --> Games
  Evaluate --> Rounds
  Evaluate --> PrefixRatings
