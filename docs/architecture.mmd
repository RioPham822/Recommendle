flowchart LR
  %% Client / UI
  subgraph Client["Frontend (React + Vite)"]
    UI["Game UI\n(Auth, Welcome, Onboarding, Rounds, Summary)"]
    APIClient["src/lib/api.js"]
    UI --> APIClient
  end

  %% Backend runtime
  subgraph Backend["Backend (FastAPI - app.main)"]
    Main["main.py\nstartup: init_db + schema check + model refresh"]
    GameRoutes["routes/game.py\n/api/game/*"]
    AuthRoutes["routes/auth.py\n/api/auth/*"]
    ProductRoutes["main.py routes\n/api/products*"]
    GameService["services/game_service.py\nsession flow, scoring, explanations"]
    AuthService["services/auth.py\nregistration/login/session tokens"]
    Recommender["services/recommender.py\nfeature space + cached item vectors"]
    Model["ml/prefix_cf.py\nPrefixCFModel + hidden preference detection"]
    CategoryProfiles["category_profiles.py\ncategory config + feature extraction labels"]
    SchemaGuard["services/schema_service.py\ncategory compatibility checks"]
  end

  %% Database
  subgraph Postgres["Postgres (decidio)"]
    Products[("products")]
    Users[("users")]
    Games[("games")]
    GameRounds[("game_rounds")]
    PrefixRatings[("prefix_ratings")]
  end

  %% Data pipelines / scripts
  subgraph DataPipelines["Data Pipelines (backend/scripts)"]
    LoadPens["load_db.py\nloads backend/data/products.json"]
    IngestMovies["ingest_movies_tmdb.py\nTMDB -> products(category=movies)"]
    Checkpoint["backend/data/tmdb_ingest_checkpoint.json\nmovie ingest resume state"]
    MigrateSchema["migrate_multicategory_schema.py\ncompatibility helper"]
    Eval["evaluate_pbcf.py\noffline metrics + reports"]
  end

  %% Runtime request flow
  APIClient -->|HTTP /api/game/*| GameRoutes
  APIClient -->|HTTP /api/auth/*| AuthRoutes
  APIClient -->|HTTP /api/products*| ProductRoutes

  Main --> SchemaGuard
  Main --> Recommender
  Main --> GameRoutes
  Main --> AuthRoutes

  GameRoutes --> GameService
  AuthRoutes --> AuthService
  GameService --> Recommender
  GameService --> Model
  GameService --> CategoryProfiles

  %% Data access flow
  ProductRoutes --> Products
  AuthService --> Users
  GameService --> Products
  GameService --> Users
  GameService --> Games
  GameService --> GameRounds
  GameService --> PrefixRatings

  %% Ingestion / evaluation flow
  LoadPens --> Products
  IngestMovies --> Products
  IngestMovies --> Checkpoint
  MigrateSchema --> Products
  MigrateSchema --> Games
  MigrateSchema --> GameRounds
  Eval --> Games
  Eval --> GameRounds
